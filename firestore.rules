rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable general credentials helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == "ritesh.ds.001@gmail.com";
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // PortfolioData validation helper
    function isValidPortfolio(data) {
      return data.heroName is string && data.heroName.size() <= 200
          && data.introText is string && data.introText.size() <= 5000
          && data.contactEmail is string && data.contactEmail.size() <= 320;
    }

    // ContactMessage validation helper
    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && data.email is string && data.email.size() > 0 && data.email.size() <= 320
          && data.subject is string && data.subject.size() <= 500
          && data.message is string && data.message.size() > 0 && data.message.size() <= 10000;
    }

    // Portfolio CMS Content Rules
    match /portfolio/{docId} {
      allow get: if isValidId(docId);
      allow list: if false; // No directory listings of portfolio collection
      
      allow create: if isAdmin() && isValidId(docId) && isValidPortfolio(incoming());
      allow update: if isAdmin() && isValidId(docId) && isValidPortfolio(incoming());
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Inbound Messages Rules
    match /messages/{messageId} {
      allow get: if isAdmin() && isValidId(messageId);
      allow list: if isAdmin(); // Visitors cannot list other messages
      
      allow create: if isValidId(messageId) && isValidMessage(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isAdmin() && isValidId(messageId);
    }
  }
}
